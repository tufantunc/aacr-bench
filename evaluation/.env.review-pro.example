# .env template for the pre-registered review-pro vs /code-review comparison
# https://github.com/tufantunc/review-pro/tree/main/studies/2026-08-aacr-bench-comparison
#
#   cp .env.review-pro.example .env      # .env is gitignored — never commit it
#   set -a && source .env && set +a      # load before review runs
#
# The OCR and Codex sections of the upstream .env.example are omitted: phase 1
# uses only the `claude` and `review-pro` arms plus the judge.

# ─────────────────────────────────────────────────────────────────────────────
# ARMS (A1 = --reviewer claude, A2 = --reviewer review-pro)
# Both arms share this block by design: the registration requires them to differ
# only in the reviewer, so they must run on the same endpoint and the same model.
# ─────────────────────────────────────────────────────────────────────────────

## Anthropic-compatible endpoint. For a direct Anthropic API key, use:
##   https://api.anthropic.com
export ANTHROPIC_BASE_URL="https://api.anthropic.com"

## API key / auth token for the above endpoint.
export ANTHROPIC_AUTH_TOKEN=""

## Pinned arm model. The registration pins claude-opus-5 for phase 1.
export ANTHROPIC_MODEL="claude-opus-5"

## How many times Claude Code retries a failing API call before the StopFailure
## hook records exhaustion. Framework default is 10; left explicit so the value
## is part of the run record rather than an implicit default.
export CLAUDE_CODE_MAX_RETRIES="10"

# ─────────────────────────────────────────────────────────────────────────────
# review-pro arm (A2) only
# ─────────────────────────────────────────────────────────────────────────────

## Absolute path to the core/ directory of a review-pro checkout pinned to the
## registered version (v0.5.0 @ 26341fe). The adapter copies skills/ and agents/
## from here into an isolated CLAUDE_CONFIG_DIR per instance, so your real
## ~/.claude is never touched and the pin is this checkout — not whatever npm
## would resolve today.
##
## Pin the checkout before the scored run:
##   cd ~/Desktop/Projects/Personal/review-pro && git checkout 26341fe
## (return to main afterwards; or keep a separate worktree for the pinned copy)
export REVIEW_PRO_CORE_DIR="/Users/tufantunc/Desktop/Projects/Personal/review-pro/core"

## Optional: one stack pack to install into each reviewed repo's .review-pro/.
## Leave EMPTY for phase 1 — AACR-Bench spans 10 languages, so a single pack
## would apply the wrong signals to most instances. Recorded in the result
## envelope when set.
export REVIEW_PRO_STACK_PACK=""

# ─────────────────────────────────────────────────────────────────────────────
# JUDGE (scores every arm, all phases)
# Must not share a model family with any arm — GLM vs Anthropic arms: OK.
# ─────────────────────────────────────────────────────────────────────────────

## z.ai OpenAI-compatible endpoint.
export JUDGE_BASE_URL="https://api.z.ai/api/coding/paas/v4"

## z.ai API key.
export JUDGE_API_KEY=""

## Judge model. Exact id recorded in the freeze amendment.
export JUDGE_MODEL="glm-5.3"

## true = force local mock similarity instead of calling the judge model.
## Set to "true" for the smoke run (pipeline validation, zero judge cost),
## then back to "false" for the scored run.
export JUDGE_USE_MOCK="false"

# ─────────────────────────────────────────────────────────────────────────────
# RUNNING IT — pausing and resuming
# ─────────────────────────────────────────────────────────────────────────────
#
# Review is resumable: an instance whose result file already exists is skipped,
# so an interrupted run continues by re-issuing the SAME command with the SAME
# --run-id. Remaining instances keep the dataset order fixed by the sampling
# seed. Evaluate once at the end, over all accumulated results.
#
#   caffeinate -is python -m pipeline run --stage review --reviewer claude \
#       --dataset data/aacr_bench.jsonl --run-id phase1 --timeout-minutes 45
#   # quota runs out -> stop -> later, same command again -> continues
#   python -m pipeline run --stage eval --reviewer claude \
#       --dataset data/aacr_bench.jsonl --run-id phase1 --eval-rounds 3
#
# `caffeinate -is` matters: subprocess timeouts are wall-clock, so if the machine
# sleeps mid-review for longer than --timeout-minutes, that instance times out
# (findings reported to MCP up to that point survive; the rest is lost and the
# instance is recorded as a timeout). Sleeping BETWEEN runs is harmless.
#
# --force re-reviews instances that already have results. Per the study's
# registration, any such re-review must be logged with its reason — it is an
# escape hatch for infrastructure failures, not for retrying unwanted output.
